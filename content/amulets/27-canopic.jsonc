// What the codex says about an amulet. The drawing itself is built in,
// or comes from a picture in images/amulets/ with the same name as the id.
{
	"id": "canopic",
	"name": "Jar of Duamutef",
	"plural": "jars of Duamutef",
	"meaning": "A canopic jar with the head of Duamutef, the jackal-headed son of Horus, who guarded the stomach. Four such jars held the organs taken out during embalming."
}
