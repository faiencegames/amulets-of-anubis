// What the codex says about an amulet. The drawing itself is built in,
// or comes from a picture in images/amulets/ with the same name as the id.
{
	"id": "cartouche",
	"name": "Cartouche",
	"plural": "cartouches",
	"meaning": "The oval loop of rope that encloses a royal name. This one holds the throne name of Thutmose III, Men-kheper-Ra."
}
