// What the codex says about an amulet. The drawing itself is built in,
// or comes from a picture in images/amulets/ with the same name as the id.
{
	"id": "throne",
	"name": "Throne of Isis",
	"plural": "thrones of Isis",
	"meaning": "Isis's name, Aset, is written with the sign of a seat, and She wears it on Her head. Her temple at Philae was among the last to keep the old worship."
}
