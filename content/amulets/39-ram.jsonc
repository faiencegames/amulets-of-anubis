// What the codex says about an amulet. The drawing itself is built in,
// or comes from a picture in images/amulets/ with the same name as the id.
{
	"id": "ram",
	"name": "Ram of Amun",
	"plural": "rams of Amun",
	"meaning": "The ram was sacred to Amun of Thebes. An avenue of ram-headed sphinxes leads to His temple at Karnak."
}
