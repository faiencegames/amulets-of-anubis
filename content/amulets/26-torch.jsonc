// What the codex says about an amulet. The drawing itself is built in,
// or comes from a picture in images/amulets/ with the same name as the id.
{
	"id": "torch",
	"name": "Torch",
	"plural": "torches",
	"meaning": "Tombs were cut and painted deep in the rock by the light of lamps and torches. Records from Deir el-Medina, the tomb builders’ village, list the wicks handed out to the workmen."
}
