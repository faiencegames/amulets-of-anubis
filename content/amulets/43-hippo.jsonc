// What the codex says about an amulet. The drawing itself is built in,
// or comes from a picture in images/amulets/ with the same name as the id.
{
	"id": "hippo",
	"name": "Faience hippo",
	"plural": "faience hippos",
	"meaning": "Blue faience hippopotamuses, painted with the plants of the marsh, were placed in Middle Kingdom tombs. Taweret, a hippo Goddess, protected mothers and children."
}
