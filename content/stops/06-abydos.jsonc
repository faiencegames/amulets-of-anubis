	"frame_colours": ["#343a60", "#12142a", "#8a92c8"],
	"map_position": {"x": 180, "y": 289, "label": "left"},
	// Three seals: challenges stamped the first time a win here meets them.
	// Keep their order; saves remember seals by position.
	"seals": [
