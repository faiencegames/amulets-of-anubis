// A tomb or temple chamber beside a stop: a small, dim board, opened once
// that stop is gilded. Some amulets start buried in sand: in "floor_plan",
// s is a stone with a buried amulet on it and S a thick stone with one.
// A buried amulet can't be moved; a match beside it brushes the sand off.
// "reward" is paid the first time the chamber is explored; "return_reward" on every visit after.
{
	"id": "serapeum",
	"at": "saqqara",
	"name": "The Serapeum",
	"text": "At Saqqara we went down into the dark, where the long galleries of the Serapeum run beneath the sand. Here the sacred Apis bulls of Memphis were laid to rest, each in a stone coffin cut from a single block, so vast we could scarcely believe our eyes. Auguste Mariette found these galleries in 1850 by following a buried avenue of sphinxes and we followed the same road down.",
	"scenery": "tomb",
	// Three sets: each time the place opens, the game picks one at random.
	"amulets": [
		["mummy", "jar", "torch", "anubis", "collar"],
		["bull", "torch", "jar", "was", "heart"],
		["bull", "mummy", "torch", "shen", "nefer"]
	],
	"moves": 26,
	"floor_plan": [
		"........",
		"11111111",
		"1s1ss1s1",
		"11111111",
		"11111111",
		"1s1ss1s1",
		"11111111",
		"........"
	],
	"reward": {"lapis": 15},
	// "return_reward" is paid on the first return; each return after pays more,
	// as the chamber wakes a little more each time (cursed badges; see "returning" in settings.json).
	"return_reward": {"lapis": 15}
}
