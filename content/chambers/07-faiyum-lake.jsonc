// An oasis beside a stop: a small board in daylight, opened once that stop
// is gilded. Some amulets start under water: in "floor_plan", w is a stone
// with an amulet under water on it and W a thick stone with one. An amulet
// under water can't be moved; a match beside it lifts it out.
// "reward" is paid the first time the oasis is explored; "return_reward" on every visit after.
{
	"id": "faiyum-lake",
	"at": "faiyum",
	"setting": "oasis",
	"name": "The lake of the Faiyum",
	"text": "West of the Nile we came to the great lake of the Faiyum, fed by the Bahr Yussef; the Greeks called it Lake Moeris. Kings of the Middle Kingdom drained the marshes around it to win new farmland, and the Faiyum is farmed to this day.",
	"scenery": "oasis",
	// Three sets: each time the place opens, the game picks one at random.
	"amulets": [
		["croc", "fish", "ibis", "pomegranate", "ankh"],
		["frog", "hippo", "sara", "lotus", "ankh"],
		["croc", "goose", "bluelotus", "fish", "pomegranate"]
	],
	"moves": 26,
	"floor_plan": [
		"11111111",
		"11111111",
		"1w1ww1w1",
		"11111111",
		"11111111",
		"1w1ww1w1",
		"11111111",
		"........"
	],
	"reward": {"lapis": 15},
	// "return_reward" is paid on every later visit.
	"return_reward": {"lapis": 7}
}
