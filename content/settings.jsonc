// The numbers that tune the whole game. Every one is optional: leave one out
// and the game uses the number shown here. After a change, build and try it
// (dist/try-it.html). To check the balance, see README.md, "Balancing".
{
	// ---- the journey ----

	// How many stops are open at the very start (1 = only the first; the next
	// opens each time one is won). 12 opens the whole river at once.
	"stops_open_at_start": 1,

	// When each part of the game arrives on a player's first journey: the stop
	// number it arrives at (2 = after the first win). "omens" may also be
	// "after the journey". From the second journey on, everything is on.
	// learning_pace is where new players start: "one at a time" or
	// "everything now" (they can change it in Menu -> Learning pace).
	"staging": {
		"learning_pace": "one at a time",
		"seals": 2,
		"badges": 3,
		"trials": 4,
		"stall": 5,
		"events": 6,
		"curses": 8,
		"chambers": 9,                  // tomb and temple chambers beside the stops
		"omens": "after the journey",
		// The stops are balanced with badges in play (their extra moves and
		// gilding help a lot). Until badges arrive, a stop gives this much
		// more (in percent) of its moves, so the first stops are not harder
		// than later ones. Check with: node engine/tools/journey-sim.js
		"extra_moves_before_badges_percent": 50
	},

	// Stars for a won stop, by the share of moves left over.
	"stars": {
		"three_stars_moves_left_percent": 30,
		"two_stars_moves_left_percent": 15
	},

	// The amulets the interface shows as examples: "button" on the Amulets
	// button and in the floor previews, "how_to_play" in How to play, and four
	// "previews" to show a look where a stop has fewer of its own. (The one
	// shown under each cover is in its file, content/covers/.)
	"amulets_on_show": {
		"button": "scarab",
		"how_to_play": "ankh",
		"previews": ["scarab", "ankh", "eye", "lotus"]
	},

	// The four difficulty steps, easiest first. Their names are this game's
	// own: saves keep a difficulty by its place, and curses and relics name
	// it, so never rename one. moves_percent scales every stop's moves;
	// badge_chance_percent is how often a new amulet falls wearing a badge;
	// hint_after_seconds is how long before a hint (0 = never).
	// (Their descriptions are in content/text.json, "difficulty".)
	"difficulty": {
		"Relaxed": {"moves_percent": 140, "badge_chance_percent": 4.0, "hint_after_seconds": 6},
		"Normal":  {"moves_percent": 100, "badge_chance_percent": 2.2, "hint_after_seconds": 9},
		"Hard":    {"moves_percent": 85,  "badge_chance_percent": 1.5, "hint_after_seconds": 15},
		"Pharaoh": {"moves_percent": 72,  "badge_chance_percent": 0.8, "hint_after_seconds": 0}
	},

	// ---- things that happen ----

	// How often (in percent) sailing on to the next stop is interrupted by a
	// river event.
	"river_event_percent": 30,

	// How often (in percent) a priest offers a trial when a stop begins (the
	// Treasury's "Ear of the priest" adds to it).
	"trial_offer_percent": 30,

	// Badges: how often each turns up, its "weight", is in its own file in
	// content/badges/. Here: how many good badges may be on the board at once.
	"badges": {
		"most_good_badges_at_once": 2
		// how much likelier cursed badges are under the omen "Chaos stirs" is
		// in its file, content/omens/04-chaos.json
	},

	// Tombs and temples explored before wake when the player goes back in:
	// cursed badges (Apep and the sandstorm) start to turn up, and grow likelier
	// with each return, and so does the reward. Oases stay calm. "curse_multiplier" is how much likelier
	// the cursed badges are than their weight above, on the first return; each
	// further return adds "each_return", up to "most".
	"returning": {
		"badge_chance_percent": 3,     // badges on the board of a return visit (a first visit has 2)
		"curse_multiplier": 8,
		"each_return": 8,
		"most": 40,
		// the reward rises with the danger: each return after the first pays this
		// much more (in percent) of the chamber's "return_reward", until the
		// curses stop growing
		"reward_percent_each_return": 50
	},

	// Sound: "Steadier sound" (Menu → Settings → Sound and music) asks for an audio buffer this long,
	// in milliseconds, for phones where the sound hitches now and then. Longer is
	// steadier, but every sound comes that much later after a tap.
	"sound": {"steady_buffer_ms": 80},

	// Omens: each one braved adds this much (in percent) to the gold and lapis a win pays.
	"omens": {"reward_percent_each": 30},

	// Seals: lapis paid for each seal stamped.
	"seals": {"lapis_each": 4},

	// The Nile down the middle of an Omega board: the water at its banks and
	// in the middle, the ripples on it, and the reeds along both banks.
	"river_channel": {
		"water_edge": "#1d4f73",
		"water_middle": "#2f78a6",
		"ripples": "rgba(220,240,255,.35)",
		"reeds": "rgba(60,110,50,.55)"
	},

	// ---- money ----

	// How much dearer (in percent) something at Anubis's stall gets each time
	// it is bought again at the same stop. It settles again at the next stop.
	"stall_price_rise_percent": 50,

	// Failing a stop makes the next try there kinder.
	"persistence": {
		"extra_moves_per_failure": 2,   // moves added for each failure...
		"failures_that_count": 3,       // ...up to this many failures
		"boon_after_failures": 3        // a free boon after this many failures in a row
	},

	"earnings": {
		"stones_per_gold": 3,       // one gold for every 3 stones gilded
		"specials_per_lapis": 3,    // one lapis for every 3 special amulets made
		"gold_for_winning": 20,     // gold for gilding a stop...
		"gold_per_spare_move": 2,   // ...plus this much for each move left over
		"lapis_for_winning": 1      // lapis for gilding a stop
	}
}
