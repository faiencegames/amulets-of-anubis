		"lede": "Relics are found by deeds along the river, and kept on every journey. Tap one to read about it.",
		"gave": "It gave",
		"gives": "Finding it gives",
		"nothing": "Simply a fine piece for the collection.",
		"unknown": "Unknown relic",
		"codex": "See every relic in How to play"
