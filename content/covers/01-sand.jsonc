// A cover: something an amulet can be held under, as sand in a tomb. An
// amulet under it can't be moved and fires no power; a match on it or beside
// it breaks the cover. Its picture is images/covers/<id>.svg, drawn over the
// amulet (and <id>-2.svg and so on, if it looks different with that many
// layers left). The first cover is the one curses and omens use.
{
	"id": "sand",
	// its name and what it means, in How to play ("Tombs & oases")
	"name": "Buried in sand",
	"text": "This amulet can’t be moved and it is in no match. Make a match right beside it or blast it with a special to brush the sand off. From then on it is an ordinary amulet and the stone under it is gilded when you match it.",
	// shown when the player tries to move one
	"popup": "Buried in sand: match beside it",
	// in a floor plan: the letter on bare stone and on thick stone
	// the note on the card of a chamber whose floor has it (else its "popup")
	"chamber_note": "Some amulets are buried in sand. They can't be moved: make a match beside one to brush it clean.",
	"letters": ["s", "S"],
	// how many hits break it
	"layers": 1,
	// "beside": a match on it or beside it is a hit; "on": only on it
	"broken_by": "beside",
	// the amulet under it still counts in a match where it lies (it stays,
	// and the match breaks a layer): true or false
	"matches": false,
	// after a move that broke none of it, it grows onto an amulet beside it
	"spreads": false,
	// the sound it makes breaking and the two colours it bursts into
	"sound": "sand",
	"burst": ["#e8c98a", "#b88a48"],
	// the amulet How to play shows under it
	"amulet_on_show": "mummy"
}
